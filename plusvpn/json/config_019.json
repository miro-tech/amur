{
  "remarks": "@shenvpn",
  "log": {
    "loglevel": "none",
    "access": "",
    "error": ""
  },
  "inbounds": [
    {
      "tag": "socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    },
    {
      "tag": "http",
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "settings": []
    }
  ],
  "outbounds": [
    {
      "mux": {
        "concurrency": -1,
        "enabled": false
      },
      "protocol": "trojan",
      "settings": {
        "servers": [
          {
            "level": 8,
            "address": "188.114.97.6",
            "port": 443,
            "password": "humanity"
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "echConfigList": "ip.gs+udp://8.8.8.8",
          "serverName": "www.calmlunch.com"
        },
        "wsSettings": {
          "path": "/assignment",
          "headers": {
            "Host": "www.calmlunch.com"
          }
        }
      },
      "tag": "proxy-0"
    },
    {
      "tag": "direct",
      "protocol": "freedom"

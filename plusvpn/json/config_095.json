{
  "dns": {
    "queryStrategy": "UseIPv4",
    "servers": [
      {
        "address": "https+local://1.1.1.1/dns-query",
        "domains": [
          "full:owl.zentaris.website"
        ],
        "skipFallback": true
      },
      "https://1.1.1.1/dns-query",
      "https://8.8.8.8/dns-query",
      "https://9.9.9.9/dns-query"
    ],
    "tag": "dns-module"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "enabled": true,
        "routeOnly": true
      },
      "tag": "socks"
    }
  ],
  "log": {
    "access": "none",
    "dnsLog": false,
    "loglevel": "warning"
  },
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "owl.zentaris.website",
            "port": 443,
            "users": [
              {
                "encryption": "none",
                "flow": "",
                "id": "25ac78e7-6d1d-4c9a-a450-c01a4871769f"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "sockopt": {
          "domainStrategy": "ForceIPv4"
        },
        "tlsSettings": {
          "allowInsecure": false,
          "alpn": [
            "h2",
            "http/1.1"
          ],
          "fingerprint": "firefox",
          "serverName": "owl.zentaris.website"
        },
        "xhttpSettings": {
          "extra": {
            "noSSEHeader": false,
            "scMaxBufferedPosts": 512,
            "scMaxEachPostBytes": "20480-24576",
            "scMinPostsIntervalMs": "2-3",
            "seqKey": "segment",
            "seqPlacement": "query",
            "serverMaxHeaderBytes": 262144,
            "sessionIDKey": "media_session",
            "sessionIDLength": "22-30",
            "sessionIDPlacement": "query",
            "sessionIDTable": "Base62",
            "uplinkChunkSize": "4096-6144",
            "uplinkDataKey": "data",
            "uplinkDataPlacement": "header",
            "uplinkHTTPMethod": "GET",
            "xPaddingBytes": "64-320",
            "xPaddingHeader": "Referer",
            "xPaddingKey": "cacheVersion",
            "xPaddingMethod": "tokenish",
            "xPaddingObfsMode": true,
            "xPaddingPlacement": "queryInHeader",
            "xmux": {
              "cMaxReuseTimes": "128-256",
              "hMaxRequestTimes": "1200-2400",
              "hMaxReusableSecs": "900-1800",
              "maxConcurrency": "16-32",
              "maxConnections": 0
            }
          },
          "host": "owl.zentaris.website",
          "mode": "packet-up",
          "path": "/api/api_v2/mediaupload_process"
        }
      },
      "tag": "proxy"
    },
    {
      "protocol": "dns",
      "settings": {},
      "streamSettings": {
        "sockopt": {
          "dialerProxy": "proxy"
        }
      },
      "tag": "dns-out"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "policy": {
    "system": {
      "statsOutboundDownlink": true,
      "statsOutboundUplink": true
    }
  },
  "remarks": "@shenvpn",
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "inboundTag": [
          "dns-module"
        ],
        "outboundTag": "proxy",
        "type": "field"
      },
      {
        "inboundTag": [
          "socks",
          "tun"
        ],
        "network": "tcp,udp",
        "outboundTag": "dns-out",
        "port": "53",
        "type": "field"
      },
      {
        "network": "tcp,udp",
        "outboundTag": "proxy",
        "type": "field"
      }
    ]
  },
  "stats": {}
}
{
  "remarks": "@shenvpn",
  "log": {
    "access": "",
    "error": "",
    "loglevel": "none",
    "dnsLog": false
  },
  "inbounds": [
    {
      "tag": "socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true,
        "allowTransparent": false,
        "userLevel": 8
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic",
          "fakedns"
        ],
        "metadataOnly": false,
        "routeOnly": false
      }
    },
    {
      "tag": "http",
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "settings": {
        "userLevel": 8
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic",
          "fakedns"
        ],
        "metadataOnly": false,
        "routeOnly": false
      }
    },
    {
      "tag": "dns-in",
      "listen": "127.0.0.1",
      "port": 10853,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "1.1.1.1",
        "port": 53,
        "network": "tcp,udp"
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "dey.lnmarketplace.net",
            "port": 443,
            "users": [
              {
                "id": "3536e1fa-0850-44d1-b123-925ce12476cf",
                "level": 8,
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "xhttpSettings": {
          "path": "/kavir",
          "host": "dey.lnmarketplace.net",
          "mode": "stream-one",
          "extra": {
            "noGRPCHeader": true,
            "xmux": {
              "maxConcurrency": "6",
              "hKeepAlivePeriod": 12
            },
            "headers": {
              "User-Agent": "Mozilla/5.0(WindowsNT10.0;Win64;x64)AppleWebKit/537.36(KHTML,likeGecko)Chrome/101.0.4951.67Safari/537.36"
            }
          }
        },
        "tlsSettings": {
          "allowInsecure": false,
          "serverName": "dey.lnmarketplace.net",
          "alpn": [
            "h2"
          ],
          "fingerprint": "firefox",
          "show": false
        }
      },
      "mux": {
        "enabled": false,
        "concurrency": -1,
        "xudpConcurrency": 8,
        "xudpProxyUDP443": ""
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIP"
      }
    },
    {
      "tag": "dns-out",
      "protocol": "dns",
      "settings": {
        "network": "tcp,udp",
        "address": "1.1.1.1",
        "port": 53
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "http"
        }
      }
    }
  ],
  "dns": {
    "hosts": {
      "domain:googleapis.cn": "googleapis.com"
    },
    "queryStrategy": "UseIP",
    "disableCache": false,
    "serveStale": true,
    "serveExpiredTTL": 86400,
    "enableParallelQuery": true,
    "disableFallback": false,
    "disableFallbackIfMatch": false,
    "servers": [
      {
        "tag": "dns-direct",
        "address": "1.1.1.1",
        "queryStrategy": "UseIP",
        "skipFallback": false,
        "domains": [
          "full:dey.lnmarketplace.net"
        ]
      },
      {
        "tag": "dns-direct",
        "address": "8.8.8.8",
        "queryStrategy": "UseIP",
        "skipFallback": false,
        "domains": [
          "full:dey.lnmarketplace.net"
        ]
      },
      {
        "tag": "dns-direct",
        "address": "9.9.9.9",
        "queryStrategy": "UseIP",
        "skipFallback": false,
        "domains": [
          "full:dey.lnmarketplace.net"
        ]
      },
      {
        "tag": "dns-proxy",
        "address": "https://1.1.1.1/dns-query",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-proxy",
        "address": "https://8.8.8.8/dns-query",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-direct",
        "address": "1.0.0.1",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-direct",
        "address": "8.8.4.4",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-direct",
        "address": "149.112.112.112",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-proxy",
        "address": "https://cloudflare-dns.com/dns-query",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-proxy",
        "address": "https://dns.quad9.net/dns-query",
        "queryStrategy": "UseIP",
        "skipFallback": false
      }
    ]
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "domainMatcher": "hybrid",
    "rules": [
      {
        "type": "field",
        "domain": [
          "full:dey.lnmarketplace.net"
        ],
        "network": "tcp,udp",
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "inboundTag": [
          "dns-proxy"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "inboundTag": [
          "dns-direct"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "inboundTag": [
          "dns-in"
        ],
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "protocol": [
          "dns"
        ],
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "port": "53",
        "network": "tcp,udp",
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ]
  },
  "fakedns": [
    {
      "ipPool": "198.18.0.0/15",
      "poolSize": 65535
    },
    {
      "ipPool": "fc00::/18",
      "poolSize": 65535
    }
  ],
  "policy": {
    "levels": {
      "8": {
        "handshake": 4,
        "connIdle": 180,
        "uplinkOnly": 1,
        "downlinkOnly": 1,
        "bufferSize": 64
      }
    }
  }
}
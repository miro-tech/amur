{
  "remarks": "@shenvpn",
  "log": {
    "loglevel": "none",
    "access": "",
    "error": ""
  },
  "inbounds": [
    {
      "tag": "socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    },
    {
      "tag": "http",
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "settings": []
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "151.101.193.194",
            "port": 443,
            "users": [
              {
                "id": "337bf72e-bb79-4d5f-be3f-7822eb77100c",
                "encryption": "none",
                "level": 0
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "www.firefox.com",
          "fingerprint": "chrome",
          "alpn": [
            "http/1.1"
          ],
          "verifyPeerCertByName": "*.freetls.fastly.net"
        },
        "xhttpSettings": {
          "host": "ascx-1a124d18ae2000-task-1a16db2a943000-066d0f4351.global.ssl.fastly.net",
          "path": "/",
          "mode": "auto"
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct"
      }
    ]
  },
  "dns": {
    "servers": [
      "8.8.8.8"
    ]
  }
}
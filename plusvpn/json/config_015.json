{
  "remarks": "@shenvpn",
  "log": {
    "access": "",
    "error": "",
    "loglevel": "none",
    "dnsLog": false
  },
  "inbounds": [
    {
      "tag": "socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true,
        "allowTransparent": false,
        "userLevel": 8
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic",
          "fakedns"
        ],
        "metadataOnly": false,
        "routeOnly": false
      }
    },
    {
      "tag": "http",
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "settings": {
        "userLevel": 8
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic",
          "fakedns"
        ],
        "metadataOnly": false,
        "routeOnly": false
      }
    },
    {
      "tag": "dns-in",
      "listen": "127.0.0.1",
      "port": 10853,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "1.1.1.1",
        "port": 53,
        "network": "tcp,udp"
      }
    }
  ],
  "outbounds": [
    {
      "mux": {
        "concurrency": -1,
        "enabled": false
      },
      "protocol": "trojan",
      "settings": {
        "servers": [
          {
            "level": 8,
            "address": "188.114.97.6",
            "port": 443,
            "password": "humanity"
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "alpn": [
            "http/1.1"
          ],
          "echConfigList": "cloudflare-ech.com+udp://1.1.1.1",
          "fingerprint": "chrome",
          "serverName": "www.pleadcourt.org"
        },
        "wsSettings": {
          "path": "/assignment",
          "headers": {
            "Host": "www.pleadcourt.org"
          }
        },
        "sockopt": {
          "domainStrategy": "UseIPv4v6",
          "tcpNoDelay": true,
          "tcpKeepAliveIdle": 20,
          "tcpKeepAliveInterval": 15,
          "tcpUserTimeout": 20000,
          "tcpMaxSeg": 1200,
          "dialerProxy": "fragment"
        }
      },
      "tag": "proxy"
    },
    {
      "tag": "fragment",
      "protocol": "freedom",
      "settings": {
        "fragment": {
          "packets": "tlshello",
          "length": "50-100",
          "interval": "5-10"
        }
      },
      "streamSettings": {
        "network": "tcp",
        "security": "",
        "sockopt": {
          "tcpNoDelay": true,
          "tcpKeepAliveIdle": 20,
          "tcpKeepAliveInterval": 15,
          "tcpUserTimeout": 20000,
          "tcpMptcp": true
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIP"
      }
    },
    {
      "tag": "dns-out",
      "protocol": "dns",
      "settings": {
        "network": "tcp,udp",
        "address": "1.1.1.1",
        "port": 53
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "http"
        }
      }
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "domainMatcher": "hybrid",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "dns-proxy"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "inboundTag": [
          "dns-direct"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "inboundTag": [
          "dns-in"
        ],
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "protocol": [
          "dns"
        ],
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "port": "53",
        "network": "tcp,udp",
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ]
  },
  "dns": {
    "hosts": {
      "domain:googleapis.cn": "googleapis.com"
    },
    "queryStrategy": "UseIP",
    "disableCache": false,
    "serveStale": true,
    "serveExpiredTTL": 86400,
    "enableParallelQuery": true,
    "disableFallback": false,
    "disableFallbackIfMatch": false,
    "servers": [
      {
        "tag": "dns-direct",
        "address": "1.1.1.1",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-direct",
        "address": "8.8.8.8",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-direct",
        "address": "9.9.9.9",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-proxy",
        "address": "https://1.1.1.1/dns-query",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-proxy",
        "address": "https://8.8.8.8/dns-query",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-direct",
        "address": "1.0.0.1",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-direct",
        "address": "8.8.4.4",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-direct",
        "address": "149.112.112.112",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-proxy",
        "address": "https://cloudflare-dns.com/dns-query",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-proxy",
        "address": "https://dns.quad9.net/dns-query",
        "queryStrategy": "UseIP",
        "skipFallback": false
      }
    ]
  },
  "fakedns": [
    {
      "ipPool": "198.18.0.0/15",
      "poolSize": 65535
    },
    {
      "ipPool": "fc00::/18",
      "poolSize": 65535
    }
  ],
  "policy": {
    "levels": {
      "8": {
        "handshake": 4,
        "connIdle": 180,
        "uplinkOnly": 1,
        "downlinkOnly": 1,
        "bufferSize": 64
      }
    }
  }
}
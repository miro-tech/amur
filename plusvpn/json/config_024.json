{
  "remarks": "@shenvpn",
  "log": {
    "loglevel": "none",
    "access": "",
    "error": ""
  },
  "inbounds": [
    {
      "tag": "socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true,
        "userLevel": 8
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "speedtest.net",
            "port": 80,
            "users": [
              {
                "id": "dcae26dd-b17a-4424-aea0-42ffee21ae60",
                "encryption": "none",
                "flow": "",
                "level": 8
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "sockopt": {
          "domainStrategy": "UseIP",
          "happyEyeballs": {
            "interleave": 2,
            "maxConcurrentTry": 4,
            "prioritizeIPv6": false,
            "tryDelayMs": 250
          }
        },
        "finalmask": {
          "tcp": [
            {
              "type": "fragment",
              "settings": {
                "packets": "tlshello",
                "lengths": [
                  "0",
                  "104",
                  "1"
                ],
                "delays": [
                  "0"
                ],
                "maxSplit": "0"
              }
            },
            {
              "type": "fragment",
              "settings": {
                "packets": "1-1",
                "lengths": [
                  "114",
                  "1"
                ],
                "delays": [
                  "1"
                ],
                "maxSplit": "11"
              }
            }
          ]
        },
        "xhttpSettings": {
          "host": "fastlysmart1209b08your-name.global.ssl.fastly.net",
          "path": "/",
          "mode": "auto",
          "extra": {
            "xPaddingBytes": "100-1000"
          }
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "http"
        }
      }
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "outboundTag": "block",
        "domain": [
          "geosite:category-ads-all"
        ]
      }
    ]
  },
  "dns": {
    "hosts": [],
    "servers": []
  }
}
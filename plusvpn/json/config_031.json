{
  "log": {
    "access": "",
    "error": "",
    "loglevel": "none",
    "dnsLog": false
  },
  "dns": {
    "hosts": {
      "domain:googleapis.cn": "googleapis.com"
    },
    "queryStrategy": "UseIP",
    "disableCache": false,
    "serveStale": true,
    "serveExpiredTTL": 86400,
    "enableParallelQuery": true,
    "disableFallback": false,
    "disableFallbackIfMatch": false,
    "servers": [
      {
        "tag": "dns-direct",
        "address": "1.1.1.1",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-direct",
        "address": "8.8.8.8",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-direct",
        "address": "9.9.9.9",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-proxy",
        "address": "https://1.1.1.1/dns-query",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-proxy",
        "address": "https://8.8.8.8/dns-query",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-direct",
        "address": "1.0.0.1",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-direct",
        "address": "8.8.4.4",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-direct",
        "address": "149.112.112.112",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-proxy",
        "address": "https://cloudflare-dns.com/dns-query",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-proxy",
        "address": "https://dns.quad9.net/dns-query",
        "queryStrategy": "UseIP",
        "skipFallback": false
      }
    ]
  },
  "inbounds": [
    {
      "tag": "socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true,
        "allowTransparent": false,
        "userLevel": 8
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic",
          "fakedns"
        ],
        "metadataOnly": false,
        "routeOnly": false
      }
    },
    {
      "tag": "http",
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "settings": {
        "userLevel": 8
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic",
          "fakedns"
        ],
        "metadataOnly": false,
        "routeOnly": false
      }
    },
    {
      "tag": "dns-in",
      "listen": "127.0.0.1",
      "port": 10853,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "1.1.1.1",
        "port": 53,
        "network": "tcp,udp"
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "194.238.79.229",
            "port": 50632,
            "users": [
              {
                "id": "1ce5720f-4926-41bf-a0a3-71bed46a8572",
                "email": "t@t.tt",
                "security": "auto",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "sockopt": {
          "domainStrategy": "UseIPv4v6",
          "tcpNoDelay": true,
          "tcpKeepAliveIdle": 20,
          "tcpKeepAliveInterval": 15,
          "tcpUserTimeout": 20000,
          "tcpMaxSeg": 1200,
          "tcpMptcp": true
        }
      },
      "mux": {
        "enabled": false,
        "concurrency": -1
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIP"
      }
    },
    {
      "tag": "dns-out",
      "protocol": "dns",
      "settings": {
        "network": "tcp,udp",
        "address": "1.1.1.1",
        "port": 53
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "http"
        }
      }
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "domainMatcher": "hybrid",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "dns-proxy"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "inboundTag": [
          "dns-direct"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "inboundTag": [
          "dns-in"
        ],
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "protocol": [
          "dns"
        ],
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "port": "53",
        "network": "tcp,udp",
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ]
  },
  "remarks": "@shenvpn",
  "fakedns": [
    {
      "ipPool": "198.18.0.0/15",
      "poolSize": 65535
    },
    {
      "ipPool": "fc00::/18",
      "poolSize": 65535
    }
  ],
  "policy": {
    "levels": {
      "8": {
        "handshake": 4,
        "connIdle": 180,
        "uplinkOnly": 1,
        "downlinkOnly": 1,
        "bufferSize": 64
      }
    }
  }
}
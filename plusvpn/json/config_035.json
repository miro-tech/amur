{
  "remarks": "@shenvpn",
  "log": {
    "access": "",
    "error": "",
    "loglevel": "none",
    "dnsLog": false
  },
  "inbounds": [
    {
      "tag": "socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true,
        "allowTransparent": false,
        "userLevel": 8
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic",
          "fakedns"
        ],
        "metadataOnly": false,
        "routeOnly": false
      }
    },
    {
      "tag": "http",
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "settings": {
        "userLevel": 8
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic",
          "fakedns"
        ],
        "metadataOnly": false,
        "routeOnly": false
      }
    },
    {
      "tag": "dns-in",
      "listen": "127.0.0.1",
      "port": 10853,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "1.1.1.1",
        "port": 53,
        "network": "tcp,udp"
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "vn74kujn.selqora.ir",
            "port": 51595,
            "users": [
              {
                "id": "4dafdf5a-6c29-4a79-993d-a6731775544e",
                "level": 8,
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "tcpSettings": {
          "header": {
            "type": "http",
            "request": {
              "path": [
                "/"
              ],
              "headers": {
                "Host": [
                  "play.google.com"
                ],
                "User-Agent": [
                  "Mozilla/5.0 (Linux; Android 10; K) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.6478.122 Mobile Safari/537.36"
                ],
                "Accept-Encoding": [
                  "gzip, deflate"
                ],
                "Connection": [
                  "keep-alive"
                ],
                "Pragma": "no-cache"
              },
              "version": "1.1",
              "method": "GET"
            }
          }
        },
        "sockopt": {
          "domainStrategy": "UseIPv4v6",
          "tcpNoDelay": true,
          "tcpKeepAliveIdle": 20,
          "tcpKeepAliveInterval": 15,
          "tcpUserTimeout": 20000,
          "tcpMaxSeg": 1200,
          "tcpMptcp": true,
          "happyEyeballs": {
            "tryDelayMs": 250,
            "prioritizeIPv6": false,
            "interleave": 1,
            "maxConcurrentTry": 4
          }
        }
      },
      "mux": {
        "enabled": false,
        "concurrency": -1,
        "xudpConcurrency": 8,
        "xudpProxyUDP443": ""
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIP"
      }
    },
    {
      "tag": "dns-out",
      "protocol": "dns",
      "settings": {
        "network": "tcp,udp",
        "address": "1.1.1.1",
        "port": 53
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "http"
        }
      }
    }
  ],
  "dns": {
    "hosts": {
      "domain:googleapis.cn": "googleapis.com"
    },
    "queryStrategy": "UseIP",
    "disableCache": false,
    "serveStale": true,
    "serveExpiredTTL": 86400,
    "enableParallelQuery": true,
    "disableFallback": false,
    "disableFallbackIfMatch": false,
    "servers": [
      {
        "tag": "dns-direct",
        "address": "1.1.1.1",
        "queryStrategy": "UseIP",
        "skipFallback": false,
        "domains": [
          "full:vn74kujn.selqora.ir"
        ]
      },
      {
        "tag": "dns-direct",
        "address": "8.8.8.8",
        "queryStrategy": "UseIP",
        "skipFallback": false,
        "domains": [
          "full:vn74kujn.selqora.ir"
        ]
      },
      {
        "tag": "dns-direct",
        "address": "9.9.9.9",
        "queryStrategy": "UseIP",
        "skipFallback": false,
        "domains": [
          "full:vn74kujn.selqora.ir"
        ]
      },
      {
        "tag": "dns-proxy",
        "address": "https://1.1.1.1/dns-query",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-proxy",
        "address": "https://8.8.8.8/dns-query",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-direct",
        "address": "1.0.0.1",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-direct",
        "address": "8.8.4.4",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-direct",
        "address": "149.112.112.112",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-proxy",
        "address": "https://cloudflare-dns.com/dns-query",
        "queryStrategy": "UseIP",
        "skipFallback": false
      },
      {
        "tag": "dns-proxy",
        "address": "https://dns.quad9.net/dns-query",
        "queryStrategy": "UseIP",
        "skipFallback": false
      }
    ]
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "domainMatcher": "hybrid",
    "rules": [
      {
        "type": "field",
        "domain": [
          "full:vn74kujn.selqora.ir"
        ],
        "network": "tcp,udp",
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "inboundTag": [
          "dns-proxy"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "inboundTag": [
          "dns-direct"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "inboundTag": [
          "dns-in"
        ],
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "protocol": [
          "dns"
        ],
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "port": "53",
        "network": "tcp,udp",
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ]
  },
  "fakedns": [
    {
      "ipPool": "198.18.0.0/15",
      "poolSize": 65535
    },
    {
      "ipPool": "fc00::/18",
      "poolSize": 65535
    }
  ],
  "policy": {
    "levels": {
      "8": {
        "handshake": 4,
        "connIdle": 180,
        "uplinkOnly": 1,
        "downlinkOnly": 1,
        "bufferSize": 64
      }
    }
  }
}